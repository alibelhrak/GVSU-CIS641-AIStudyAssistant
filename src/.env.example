# Copy this file to .env and edit it.

# Any long random string. Used to sign login tokens.
JWT_SECRET=replace-with-a-long-random-string

# Port the app is served on (http://localhost:8080)
APP_PORT=8080

# ---- LLM (optional) ----------------------------------------------------
# Leave all three empty to use the built-in rule-based recommendation text.
# Llama 3.2 with Ollama installed on this computer:
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=llama3.2
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional: a bigger model just for the Ask AI chat (defaults to LLM_MODEL)
#   CHAT_MODEL=openai/gpt-oss-120b
CHAT_MODEL=

# Reminders: push notification keys (npx web-push generate-vapid-keys) and the scheduler's password
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=
